{
  "name": "tung-buoc",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test __tests__/*.test.ts",
    "test:coverage": "node --experimental-strip-types --experimental-test-coverage --test-coverage-include=src/validation.ts --test-coverage-include=src/today/model.ts --test-coverage-include=src/calendar/model.ts --test-coverage-include=src/calendar/taskEvents.ts --test-coverage-include=src/storage/codec.ts --test __tests__/*.test.ts",
    "test:e2e": "expo export --platform web && playwright test"
  },
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.25",
    "expo-font": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  }
}
